# ===== MediaBot sozlamalari =====
# @BotFather'dan olingan token (MAJBURIY)
BOT_TOKEN=123456789:AAAA_your_token_here_from_BotFather

# Mini App manzili — albatta HTTPS bo'lishi kerak (reverse proxy yoki cloudflared orqali)
WEBAPP_URL=https://mediabot.example.com

# Ichki web server (Mini App + /api). Docker ichida 0.0.0.0 qoldiring.
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ===== SHAXSIY REJIM (faqat siz uchun) =====
# Botdan va Mini App'dan foydalana oladigan Telegram ID'lar (vergul bilan).
# ID'ingizni bilmasangiz: shu joyni bo'sh qoldirib botni ishga tushiring va unga /start yuboring —
# bot ID'ingizni aytadi. Keyin shu yerga yozib, botni qayta ishga tushiring.
# Bo'sh bo'lsa bot HECH KIMGA hech narsa yuklamaydi (sozlash rejimi).
ALLOWED_USER_IDS=
# true = bot hamma uchun ochiq bo'ladi. Shaxsiy foydalanish uchun false qoldiring!
PUBLIC_MODE=false

# Adminlar (/stats, /broadcast). Bo'sh bo'lsa — ALLOWED_USER_IDS dagilar admin bo'ladi.
ADMIN_IDS=

# Yuklash limiti (MB). Oddiy Bot API: 50. Local telegram-bot-api server bilan: 2000 gacha.
MAX_UPLOAD_MB=50
# Local Bot API server manzili (ixtiyoriy), masalan: http://telegram-bot-api:8081
TELEGRAM_API_BASE=

MAX_DURATION_MIN=120
MAX_CONCURRENT_DOWNLOADS=3
# Soatiga nechta yuklash (shaxsiy bot uchun kengroq)
USER_HOURLY_LIMIT=100

DOWNLOAD_DIR=./data/downloads
DB_PATH=./data/mediabot.db

# Instagram (va ba'zan YouTube) uchun Netscape formatidagi cookies fayli (ixtiyoriy).
# Faqat o'qiladigan (read-only) bo'lishi mumkin: bot har bir yuklash uchun shaxsiy nusxa oladi.
COOKIES_FILE=

# H.264 bo'lmagan videolarni H.264/AAC ga o'girish (Telegram'da hamma joyda ochilishi uchun)
TRANSCODE_NON_H264=true

# Mini App initData qancha soat amal qiladi (1..24). Qisqaroq = xavfsizroq.
INIT_DATA_MAX_AGE_HOURS=6

# FAQAT lokal ishlab chiqish uchun: initData bo'lmasa dev user (id=1). Productionda HECH QACHON true qilmang!
# Xavfsizlik uchun DEV_MODE=true faqat WEB_HOST=127.0.0.1 (loopback) va WEBAPP_URL bo'sh bo'lganda ishga tushadi.
DEV_MODE=false

# Docker build: 1 bo'lsa image yig'ilayotganda yt-dlp eng yangi versiyaga yangilanadi
YTDLP_UPGRADE=0

# Bot avatari: bot uni o'zi qo'yadi (faqat rasm o'zgarganda). O'chirish uchun qatorni bo'sh qoldiring.
# BOT_AVATAR_FILE=./assets/bot-avatar.jpg

LOG_LEVEL=INFO
